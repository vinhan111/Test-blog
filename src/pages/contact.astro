---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import ExternalLink from "../components/external-link.astro";
---

<InfoLayout>
  <div
    class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh flex flex-col justify-between"
  >
    <div>
      <H1>Muốn tham gia lớp học?</H1>

      <ul
        class="mt-4 md:mt-8 lg:mt-12 text-xl xl:text-2xl text-[#e9e4d4] text-balance list-disc list-outside"
      >
        <li>Lập trình</li><br />
        <li>Cờ Vua</li>
      </ul>
      <p
        class="mt-4 md:mt-8 lg:mt-12 text-xl xl:text-2xl text-[#e9e4d4] text-balance"
      >
        Liên hệ với tôi để đăng ký lớp học phù hợp.
      </p>

      <div class="mt-6 sm:mt-12 flex flex-col gap-1">
        <a
          href="mailto:phamvinhan@gmail.com"
          class="mb-8 w-fit group flex items-center gap-1 text-base lg:text-xl text-[#e9e4d4] hover:text-zinc-50"
        >
          phamvinhan@gmail.com
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="-rotate-45 group-hover:rotate-0 transition-all duration-300 ease-in-out"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <title>Arrow Icon</title>
            <path
              fill="currentColor"
              d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10"
              opacity=".5"></path>
            <path
              fill="currentColor"
              d="M13.53 8.47a.75.75 0 1 0-1.06 1.06l1.72 1.72H8a.75.75 0 0 0 0 1.5h6.19l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3a.75.75 0 0 0 0-1.06z"
            ></path>
          </svg>
        </a>

        <ExternalLink href="https://zalo.me/0936168430">Zalo</ExternalLink>
      </div>
    </div>
  </div>
</InfoLayout>
