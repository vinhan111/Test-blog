---
import H1 from "../components/h1.astro";
import Link from "../components/link.astro";
import Navigation from "../components/navigation";
import RootLayout from "../layouts/RootLayout.astro";
import WarpBackground from "../components/warp-background";
import AvailableForWork from "../components/available.astro";
---

<RootLayout>
	<main>
		<div class="group relative w-full min-h-dvh flex items-center justify-center">
			<div class="absolute w-full h-dvh -z-10">
				<WarpBackground
					color1="#1c1a11"
					color2="#3a321a"
					color3="#c3ab62"
					speed={0.3}
					swirl={0.3}
					swirlIterations={10}
					shapeScale={0.3}
					client:load
				/>
			</div>

			<div class="p-4 sm:p-8 absolute w-full h-dvh flex flex-col justify-between z-10">
				<div>
					<H1 size="large"> Between <br /> Logic & Light </H1>
				</div>

				<div>
					<AvailableForWork className="py-4" />
					<div class="mb-2 sm:mb-4 flex items-center justify-between">
						<div class="flex items-center gap-4">
							<Link href="#">Call</Link>
							<Link href="/projects" variant="secondary">Các Nghiên Cứu Gần Đây</Link>
						</div>

						<Navigation client:load>
							<Link href="/blog" variant="secondary">Bài Viết</Link>
							<Link href="/about" variant="secondary">Thông Tin</Link>
							<Link href="/contact" variant="secondary">Liên Hệ</Link>
						</Navigation>
					</div>
				</div>
			</div>
		</div>
	</main>
</RootLayout>
